# УРОК № 19 · Геометрія · Розділ 2. Трикутники · «Розв’язування типових вправ і задач»
# Пробіл = наступний крок. Геометрія: tri (трикутник), tick (позначки рівних відрізків), angle (дуга кута),
# rightangle (прямий кут), line dash=1 (пунктир), point label="A" (точка з підписом).
title "Розв’язування типових вправ і задач"

# 1 ── Заставка
text "УРОК № 19" 0,3.1 size=34 color=gray align=center
text "Розв’язування типових вправ і задач" 0,2.0 size=54 color=yellow align=center time=1.6
line -4.0,1.2 4.0,1.2 color=blue width=4 time=0.8
text "Геометрія · Розділ 2. Трикутники" 0,0.5 size=36 color=gray align=center
tri -1.8,-3.6 0,-1.0 1.8,-3.6 names="A,B,C" color=blue fill=blue
pause

# 2 ── Види трикутників за сторонами
clear
heading "Повторимо. Види трикутників за сторонами"
tri -5.4,-1.0 -4.2,1.08 -3.0,-1.0 names="A,B,C" ticks="1,1,1" color=blue
text "Рівносторонній" -4.2,-2.2 size=34 align=center
text "Усі сторони рівні" -4.2,-2.85 size=26 color=gray align=center
pause
tri -1.2,-1.0 0,1.5 1.2,-1.0 names="A,B,C" ticks="1,1,0" color=blue
text "Рівнобедрений" 0,-2.2 size=34 align=center
text "Дві сторони рівні" 0,-2.85 size=26 color=gray align=center
pause
tri 3.0,-1.0 3.6,1.2 5.8,-1.0 names="A,B,C" ticks="1,2,3" color=blue
text "Різносторонній" 4.4,-2.2 size=34 align=center
text "Сторони довільної довжини" 4.4,-2.85 size=26 color=gray align=center
pause

# 3 ── Види трикутників за кутами
clear
heading "Види трикутників за кутами"
tri -6.2,-1.0 -4.9,1.4 -3.0,-1.0 names="A,B,C" color=blue
text "Гострокутний" -4.6,-2.1 size=34 align=center
tex "\angle A<90^\circ,\ \angle B<90^\circ,\ \angle C<90^\circ" -4.6,-2.8 size=24 color=gray align=center
pause
tri -1.8,1.2 -1.0,-1.0 1.8,-1.0 names="M,D,N" color=blue
angle -1.0,-1.0 -1.8,1.2 1.8,-1.0 r=0.5 color=yellow
text "Тупокутний" 0.4,-2.1 size=34 align=center
tex "\angle D>90^\circ" 0.4,-2.8 size=28 color=gray align=center
pause
tri 3.8,1.4 3.8,-1.0 6.8,-1.0 names="E,K,F" color=blue
rightangle 3.8,-1.0 3.8,1.4 6.8,-1.0 size=0.3 color=yellow
text "катет" 3.0,0.2 size=24 color=gray align=center
text "катет" 5.3,-0.5 size=24 color=gray align=center
text "гіпотенуза" 6.4,0.9 size=24 color=gray align=center
text "Прямокутний" 5.3,-2.1 size=34 align=center
tex "\angle K=90^\circ" 5.3,-2.8 size=28 color=gray align=center
pause

# 4 ── Медіана
clear
heading "Повторимо… Медіана трикутника"
box -7.4,1.2 7.4,2.85 color=yellow
text "Медіаною трикутника називається відрізок, що сполучає" 0,2.4 size=30 align=center
text "вершину трикутника із серединою протилежної сторони." 0,1.7 size=30 align=center
pause
tri -3.5,-3.3 1.2,0.5 3.8,-3.3 names="A,B,C" color=white
point 2.5,-1.4 label="M" ldx=0.45 ldy=0.05 color=yellow
tick 1.2,0.5 2.5,-1.4 n=2 color=yellow
& tick 2.5,-1.4 3.8,-3.3 n=2 color=yellow
line -3.5,-3.3 2.5,-1.4 color=blue width=5 time=1.2
text "AM — медіана" -7.2,-0.6 size=34 color=blue
tex "BM=MC" -7.2,-1.5 size=40 color=yellow
pause

# 5 ── Бісектриса
clear
heading "Повторимо… Бісектриса трикутника"
box -7.4,0.95 7.4,2.85 color=yellow
text "Бісектрисою трикутника називається відрізок бісектриси кута" 0,2.5 size=28 align=center
text "трикутника, що сполучає його вершину з точкою на" 0,1.9 size=28 align=center
text "протилежній стороні трикутника." 0,1.3 size=28 align=center
pause
