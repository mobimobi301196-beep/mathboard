point -0.08,-3.5 label="L" ldx=0 ldy=-0.5 color=yellow
line -0.4,0.1 -0.08,-3.5 color=blue width=5 time=1.2
angle -0.4,0.1 -3.2,-3.5 -0.08,-3.5 r=0.8 color=yellow
& angle -0.4,0.1 -0.08,-3.5 3.6,-3.5 r=0.8 color=yellow
text "BL — бісектриса" -7.2,-0.8 size=34 color=blue
tex "\angle ABL=\angle LBC" -7.2,-1.7 size=38 color=yellow
pause

