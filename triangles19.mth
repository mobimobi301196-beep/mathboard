# 10 ── Завдання № 193
clear
heading "Завдання № 193"
text "Із точок A і B, які лежать в одній" -7.2,2.5 size=27 time=0.6
text "півплощині відносно прямої a на" -7.2,1.95 size=27 time=0.6
text "однаковій відстані від неї, опущено" -7.2,1.4 size=27 time=0.6
text "на цю пряму перпендикуляри AC і BD." -7.2,0.85 size=27 time=0.6
text "Знайдіть кут ACB, якщо" -7.2,0.3 size=27 time=0.6
tex "\angle ADC=25^\circ" -7.2,-0.35 size=38 color=yellow
line 0.4,-1.2 7.2,-1.2 color=white
line 1.2,-1.2 1.2,1.0 color=white
& line 5.8,-1.2 5.8,1.0 color=white
line 1.2,-1.2 5.8,1.0 color=blue
& line 5.8,-1.2 1.2,1.0 color=blue
rightangle 1.2,-1.2 1.2,1.0 5.8,-1.2 size=0.28 color=white
& rightangle 5.8,-1.2 5.8,1.0 1.2,-1.2 size=0.28 color=white
point 5.8,1.0 label="A" ldx=0.25 ldy=0.35 color=white
point 1.2,1.0 label="B" ldx=-0.25 ldy=0.35 color=white
point 1.2,-1.2 label="D" ldx=0 ldy=-0.45 color=white
point 5.8,-1.2 label="C" ldx=0 ldy=-0.45 color=white
tex "a" 7.0,-0.85 size=34 color=white
angle 1.2,-1.2 5.8,1.0 5.8,-1.2 r=0.8 label="25^\circ" color=yellow
pause
text "Розв’язання:" -7.2,-1.0 size=30 color=yellow
tex "AC=BD,\quad AC\perp a,\quad BD\perp a" -7.2,-1.65 size=32
tick 1.2,-1.2 1.2,1.0 n=1 color=yellow
& tick 5.8,-1.2 5.8,1.0 n=1 color=yellow
pause
tex "\triangle ADC=\triangle BCD" -7.2,-2.4 size=36 color=blue
text "за двома катетами: DC — спільний, AC = BD" -7.2,-3.0 size=24 color=gray
tex "\angle BCD=\angle ADC=25^\circ" -7.2,-3.65 size=36
angle 5.8,-1.2 1.2,1.0 1.2,-1.2 r=1.3 label="25^\circ" color=blue
pause
tex "\angle ACB=\angle ACD-\angle BCD" 4.1,-2.55 size=32 align=center
box 1.4,-3.95 6.8,-2.95 color=yellow
tex "=90^\circ-25^\circ=65^\circ" 4.1,-3.45 size=44 color=yellow align=center
pause

# 11 ── Завдання № 194
clear
heading "Завдання № 194"
line -5.62,1.8 -2.3,1.8 color=white
& line -5.62,1.8 -4.09,-0.85 color=white
& line -2.3,1.8 -0.76,-0.86 color=white
line -5.62,1.8 -0.76,-0.86 color=blue
& line -4.09,-0.85 -2.3,1.8 color=blue
point -5.62,1.8 label="A" ldx=-0.3 ldy=0.35 color=white
point -2.3,1.8 label="C" ldx=0.3 ldy=0.35 color=white
point -4.09,-0.85 label="B" ldx=-0.3 ldy=-0.4 color=white
point -0.76,-0.86 label="D" ldx=0.3 ldy=-0.4 color=white
point -3.19,0.47 label="O" ldx=0.1 ldy=0.45 color=yellow
tick -5.62,1.8 -3.19,0.47 n=1 color=yellow
& tick -3.19,0.47 -0.76,-0.86 n=1 color=yellow
& tick -4.09,-0.85 -3.19,0.47 n=2 color=yellow
& tick -3.19,0.47 -2.3,1.8 n=2 color=yellow
text "Відрізки AD і BC перетинаються" 0.4,2.5 size=26 time=0.6
text "в точці O та діляться цією точкою" 0.4,1.95 size=26 time=0.6
text "навпіл. Знайдіть кут ACD, якщо" 0.4,1.4 size=26 time=0.6
tex "\angle ABC=64^\circ,\ \angle ACO=56^\circ" 0.4,0.7 size=34 color=yellow
angle -2.3,1.8 -5.62,1.8 -3.19,0.47 r=0.7 label="56^\circ" color=yellow
& angle -4.09,-0.85 -5.62,1.8 -3.19,0.47 r=0.7 label="64^\circ" color=yellow
pause
text "Розв’язання:" -7.2,-2.0 size=30 color=yellow
tex "\triangle AOB=\triangle DOC" -7.2,-2.7 size=36 color=blue
text "AO = OD, BO = OC, кути при O вертикальні" -7.2,-3.3 size=24 color=gray
pause
tex "\angle DCO=\angle ABO=64^\circ" -7.2,-3.95 size=36
angle -2.3,1.8 -3.19,0.47 -0.76,-0.86 r=0.7 label="64^\circ" color=blue
pause
tex "\angle ACD=\angle ACO+\angle OCD" 3.6,-2.7 size=32 align=center
box 0.9,-4.2 6.4,-3.15 color=yellow
tex "=56^\circ+64^\circ=120^\circ" 3.6,-3.65 size=42 color=yellow align=center
pause

# 12 ── Підготовка до НМТ
clear
heading "Підготовка до НМТ"
text "Утворіть правильні твердження, об’єднавши початок (1—4) та кінець (А—Д)." 0,2.45 size=26 color=gray align=center
text "1.  Якщо у трикутника лише дві медіани рівні," -7.4,1.7 size=23
text "      то цей трикутник" -7.4,1.2 size=23
text "2.  Якщо у трикутника одна медіана дорівнює половині" -7.4,0.55 size=23
text "      сторони, до якої вона проведена, то цей трикутник" -7.4,0.05 size=23
text "3.  Якщо у трикутника три медіани рівні," -7.4,-0.6 size=23
text "      то цей трикутник" -7.4,-1.1 size=23
text "4.  Якщо точка перетину висот трикутника лежить поза ним," -7.4,-1.75 size=23
text "      то це трикутник" -7.4,-2.25 size=23
text "А   тупокутний" 2.4,1.7 size=23
text "Б   рівнобедрений, відмінний" 2.4,1.0 size=23
text "      від рівностороннього" 2.4,0.5 size=23
text "В   прямокутний" 2.4,-0.15 size=23
text "Г   рівносторонній" 2.4,-0.8 size=23
text "Д   гострокутний, відмінний" 2.4,-1.45 size=23
text "      від рівностороннього" 2.4,-1.95 size=23
pause
box 2.2,1.4 7.7,2.0 color=white
tex "4" 7.35,1.7 size=34 color=yellow align=center
box 2.2,0.25 7.7,1.25 color=white
tex "1" 7.35,0.75 size=34 color=yellow align=center
box 2.2,-0.45 7.7,0.15 color=white
tex "2" 7.35,-0.15 size=34 color=yellow align=center
box 2.2,-1.1 7.7,-0.5 color=white
tex "3" 7.35,-0.8 size=34 color=yellow align=center
text "Відповідь: 1 — Б,  2 — В,  3 — Г,  4 — А" 0,-3.4 size=38 color=yellow align=center
pause

