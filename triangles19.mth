pause

# 14 ── Домашнє завдання
clear
heading "Домашнє завдання"
text "Опрацюй сторінки підручника 73–84." -7.2,2.5 size=30 color=yellow
text "Виконай завдання за умовою, оформи задачу (малюнок, дано, розв’язок)" -7.2,1.85 size=28 color=gray
text "На продовженні медіани AM трикутника" -7.2,0.9 size=27 time=0.6
text "ABC за точку M відкладено відрізок MK," -7.2,0.3 size=27 time=0.6
text "який дорівнює відрізку AM. Знайдіть" -7.2,-0.3 size=27 time=0.6
text "відстань від точки K до вершини C," -7.2,-0.9 size=27 time=0.6
text "якщо AB = 6 см." -7.2,-1.5 size=27 time=0.6
tri 1.2,-2.4 2.3,0.3 5.4,-2.4 names="A,B,C" color=blue
line 1.2,-2.4 6.5,0.3 color=blue
line 5.4,-2.4 6.5,0.3 color=white
point 3.85,-1.05 label="M" ldx=0.1 ldy=-0.45 color=yellow
point 6.5,0.3 label="K" ldx=0.35 ldy=0.3 color=white
tick 2.3,0.3 3.85,-1.05 n=1 color=yellow
& tick 3.85,-1.05 5.4,-2.4 n=1 color=yellow
& tick 1.2,-2.4 3.85,-1.05 n=2 color=yellow
& tick 3.85,-1.05 6.5,0.3 n=2 color=yellow
pause
text "Підказка (за потреби):" -7.2,-2.6 size=28 color=yellow
tex "\triangle ABM=\triangle KCM\ \Rightarrow\ KC=AB=6" -7.2,-3.4 size=36
